# Names only. Neon writes most of these into .env.local (neon env pull).
# Never commit real values.

# Pooled connection, used by the app
DATABASE_URL=
# Direct connection, used only by drizzle-kit migrate
DATABASE_URL_UNPOOLED=

# Neon Auth
NEON_AUTH_BASE_URL=
# Added by hand, e.g. openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Neon Object Storage (private bucket "photos")
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
